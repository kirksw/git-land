version: 1
base: main

# Commands run before publishing; each must pass.
# pre_commit: run `pre-commit run --all-files` (requires pre-commit).
# format / build: extra commands, run between format and lint below.
validation:
  pre_commit: false
  lint: go vet ./...
  test: go test ./...

publish:
  strategy: pull_request

pull_request:
  draft: false

# Merge policy applies only to pull_request publication.
merge:
  # human (default): land stops at ready_for_merge and a human merges.
  # auto: land merges once every check passes.
  mode: human
  # method and delete_branch apply only when mode is auto:
  #   method: squash (default) | merge | rebase
  #   delete_branch: true
